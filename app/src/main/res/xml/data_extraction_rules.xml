<?xml version="1.0" encoding="utf-8"?>
<!--
   Birthdays, numbers and notes stay on this phone: nothing goes to cloud backup or to a new
   phone through device transfer. Use Settings → Export birthdays to move them yourself.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
